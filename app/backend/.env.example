# Copy this to backend/.env for docker compose. Use a freshly generated token.
WARAQ_API_TOKEN=replace-with-a-random-token-at-least-24-characters
# Comma-separated, exact website origins. Never use a wildcard.
WARAQ_ALLOWED_ORIGINS=
# Native paths are optional; PATH discovery is automatic.
# WARAQ_QPDF=C:/Program Files/qpdf/bin/qpdf.exe
# WARAQ_LIBREOFFICE=C:/Program Files/LibreOffice/program/soffice.exe
# Optional service adapters (configure these on the server, never in browser storage).
# WARAQ_STIRLING_URL=http://127.0.0.1:8080
# WARAQ_STIRLING_API_KEY=
# WARAQ_STIRLING_SCHEMA_PATH=/v3/api-docs
# WARAQ_OCRBASE_URL=http://127.0.0.1:3000
# WARAQ_OCRBASE_API_KEY=
# WARAQ_OCRBASE_SCHEMA_PATH=/openapi/json
# WARAQ_OCRBASE_MODEL=paddleocr
